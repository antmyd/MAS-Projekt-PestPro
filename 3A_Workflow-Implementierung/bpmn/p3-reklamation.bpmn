<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_P3_Reklamation_v2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.0">
  <collaboration id="Collab_P3">
    <participant id="Part_PestPro_P3" name="PestPro GmbH" processRef="P3_Reklamation" />
  </collaboration>
  <process id="P3_Reklamation" name="Service und Reklamationsbearbeitung" isExecutable="true" camunda:historyTimeToLive="P180D">
    <laneSet id="LaneSet_P3">
      <lane id="Lane_P3_QV" name="Qualitätsverantwortlicher">
        <flowNodeRef>P3_Task8</flowNodeRef>
      </lane>
      <lane id="Lane_P3_Techniker" name="Techniker">
        <flowNodeRef>P3_Task5</flowNodeRef>
        <flowNodeRef>P3_Task6</flowNodeRef>
      </lane>
      <lane id="Lane_P3_Servicemitarbeiter" name="Servicemitarbeiter">
        <flowNodeRef>P3_GW3</flowNodeRef>
        <flowNodeRef>P3_Task9</flowNodeRef>
        <flowNodeRef>P3_Task10</flowNodeRef>
        <flowNodeRef>P3_End2</flowNodeRef>
        <flowNodeRef>P3_Start</flowNodeRef>
        <flowNodeRef>P3_Task1</flowNodeRef>
        <flowNodeRef>P3_Task2</flowNodeRef>
        <flowNodeRef>P3_Task3</flowNodeRef>
        <flowNodeRef>P3_GW1</flowNodeRef>
        <flowNodeRef>P3_End1</flowNodeRef>
        <flowNodeRef>P3_GW2</flowNodeRef>
        <flowNodeRef>P3_Task4</flowNodeRef>
        <flowNodeRef>P3_Task7</flowNodeRef>
      </lane>
    </laneSet>
    <userTask id="P3_Task5" name="Nacheinsatz durchführen" camunda:assignee="techniker">
      <documentation>Der Techniker führt den Nacheinsatz gemäß Reklamationsangaben durch. Besonderes Augenmerk auf die reklamierten Bereiche. Der Einsatz folgt denselben HACCP-Vorgaben wie der Ursprungseinsatz. Ausgabe: nacheinsatzErgebnis, massnahmenNacheinsatz.</documentation>
      <incoming>Flow_0wy65b3</incoming>
      <outgoing>P3_sf5</outgoing>
    </userTask>
    <userTask id="P3_Task6" name="Nacheinsatz-Ergebnis dokumentieren" camunda:assignee="techniker">
      <documentation>Der Techniker dokumentiert das Ergebnis des Nacheinsatzes im digitalen Betriebstagebuch: durchgeführte Maßnahmen, Befundsituation, verwendete Mittel. Das Ergebnis wird dem Servicefall zugeordnet. Ausgabe: nacheinsatzBerichtId.</documentation>
      <incoming>P3_sf5</incoming>
      <outgoing>P3_sf_join</outgoing>
    </userTask>
    <userTask id="P3_Task8" name="Individuelle Lösung erarbeiten" camunda:assignee="qualitaetsverantwortlicher">
      <documentation>Der Qualitätsverantwortliche analysiert den Fall und erarbeitet eine individuelle Lösung: Teilerstattung, kostenpflichtiger Nacheinsatz, Ablehnung mit Begründung. Entscheidung wird dokumentiert. Ausgabe: loesungsTyp, loesungsBeschreibung.</documentation>
      <incoming>P3_sf6</incoming>
      <outgoing>P3_sf_join2</outgoing>
    </userTask>
    <exclusiveGateway id="P3_GW3" name="Fallabschluss einleiten">
      <incoming>P3_sf_join</incoming>
      <incoming>P3_sf_join2</incoming>
      <outgoing>P3_sf7</outgoing>
    </exclusiveGateway>
    <serviceTask id="P3_Task9" name="Zusammenfassung an Kunden senden" camunda:expression="${true}">
      <documentation>Das System versendet automatisch eine E-Mail-Zusammenfassung der ergriffenen Maßnahmen an den Kunden. Bei Jahresvertragskunden fließt der Fall in die nächste Regelinspektion ein. Eingabe: kontaktEmail, loesungsBeschreibung.</documentation>
      <incoming>P3_sf7</incoming>
      <outgoing>P3_sf8</outgoing>
    </serviceTask>
    <userTask id="P3_Task10" name="Servicefall als gelöst markieren" camunda:assignee="servicemitarbeiter">
      <documentation>Der Servicemitarbeiter schließt den Servicefall im System ab, vermerkt die ergriffenen Maßnahmen in der Kundenhistorie und setzt den Status auf 'gelöst'. Bei Jahresvertragskunden: Hinweis für nächste Regelinspektion hinterlegen. Ausgabe: fallStatus = 'geloest', abschlussDatum.</documentation>
      <incoming>P3_sf8</incoming>
      <outgoing>P3_sf_end</outgoing>
    </userTask>
    <endEvent id="P3_End2" name="Servicefall gelöst">
      <incoming>P3_sf_end</incoming>
    </endEvent>
    <startEvent id="P3_Start" name="Meldung eingehend">
      <documentation>Startformular: Kunde meldet ein Anliegen nach einem abgeschlossenen Einsatz. Erfasste Felder: auftragId (Referenzeinsatz), firmenname, kontaktperson, kontaktEmail, meldungsart (Rückfrage / Nachbefall / Qualitätsbeanstandung), meldungsBeschreibung, meldungsDatum.</documentation>
      <extensionElements>
        <camunda:formData>
          <camunda:formField id="auftragId" label="Referenz Auftrags-ID" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="firmenname" label="Firmenname" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="kontaktperson" label="Kontaktperson" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="kontaktEmail" label="E-Mail" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="meldungsart" label="Art der Meldung" type="enum">
            <camunda:value id="rueckfrage" name="Rückfrage / Auskunft" />
            <camunda:value id="nachbefall" name="Nachbefall festgestellt" />
            <camunda:value id="qualitaet" name="Qualitätsbeanstandung" />
          </camunda:formField>
          <camunda:formField id="meldungsBeschreibung" label="Beschreibung des Anliegens" type="string" />
          <camunda:formField id="meldungsDatum" label="Datum der Feststellung" type="date">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="einsatzDatum" label="Datum des Ursprungseinsatzes" type="date" />
        </camunda:formData>
      </extensionElements>
      <outgoing>P3_sf1</outgoing>
    </startEvent>
    <userTask id="P3_Task1" name="Meldung aufnehmen und Servicefall anlegen" camunda:assignee="servicemitarbeiter">
      <documentation>Der Servicemitarbeiter nimmt das Anliegen binnen eines Werktags auf, legt einen Servicefall an und klassifiziert ihn. Einfache Rückfragen werden direkt beantwortet. Reklamationen (Nachbefall, Qualitätsbeanstandung) werden weitergeleitet. Ausgabe: servicefallId, meldungsart (klassifiziert).</documentation>
      <incoming>P3_sf1</incoming>
      <outgoing>P3_sf2</outgoing>
    </userTask>
    <userTask id="P3_Task2" name="Rückfrage direkt beantworten" camunda:assignee="servicemitarbeiter">
      <documentation>Der Servicemitarbeiter beantwortet die Rückfrage anhand der vorhandenen Einsatzunterlagen (Betriebstagebuch, HACCP-Dokumentation). Die Antwort wird im Servicefall protokolliert. Ausgabe: antwortText, antwortDatum.</documentation>
      <incoming>P3_sf_rueckfrage</incoming>
      <outgoing>P3_sf_rueck_end</outgoing>
    </userTask>
    <userTask id="P3_Task3" name="Einsatzbericht prüfen" camunda:assignee="servicemitarbeiter">
      <documentation>Der Servicemitarbeiter ruft den Einsatzbericht des Ursprungseinsatzes ab und prüft: Art der durchgeführten Maßnahmen, verwendete Mittel, Einsatzdatum. Ergebnis: einsatzdatum (für Garantieprüfung), einsatzBerichtId.</documentation>
      <extensionElements>
        <camunda:formData>
          <camunda:formField id="garantieAktiv" label="Garantie aktiv (innerhalb 6 Monate)?" type="boolean" />
        </camunda:formData>
      </extensionElements>
      <incoming>P3_sf_reklamation</incoming>
      <outgoing>Flow_1rtph18</outgoing>
    </userTask>
    <exclusiveGateway id="P3_GW1" name="Art der Meldung?">
      <incoming>P3_sf2</incoming>
      <outgoing>P3_sf_rueckfrage</outgoing>
      <outgoing>P3_sf_reklamation</outgoing>
    </exclusiveGateway>
    <endEvent id="P3_End1" name="Rückfrage beantwortet">
      <incoming>P3_sf_rueck_end</incoming>
    </endEvent>
    <exclusiveGateway id="P3_GW2" name="Innerhalb Garantiezeitraum?">
      <incoming>Flow_1rtph18</incoming>
      <outgoing>P3_sf_garantie</outgoing>
      <outgoing>P3_sf_eskalation</outgoing>
    </exclusiveGateway>
    <userTask id="P3_Task4" name="Nacheinsatz-Termin einplanen" camunda:assignee="servicemitarbeiter">
      <documentation>Der Servicemitarbeiter plant einen kostenlosen Nacheinsatz binnen 5 Werktagen. Abstimmung des Termins mit dem Kunden und Disponenten. Ausgabe: nacheinsatzTermin, zugewiesenerTechniker.</documentation>
      <incoming>P3_sf_garantie</incoming>
      <outgoing>P3_sf4</outgoing>
    </userTask>
    <userTask id="P3_Task7" name="An Qualitätsverantwortliche eskalieren" camunda:assignee="servicemitarbeiter">
      <documentation>Der Servicemitarbeiter eskaliert den Vorfall an den Qualitätsverantwortlichen mit vollständiger Dokumentation: Reklamationsbeschreibung, Einsatzbericht, Kundenpräferenzen. Ausgabe: eskalationDatum, eskalationGrund.</documentation>
      <incoming>P3_sf_eskalation</incoming>
      <incoming>P3_sf4</incoming>
      <outgoing>P3_sf6</outgoing>
      <outgoing>Flow_0wy65b3</outgoing>
    </userTask>
    <sequenceFlow id="Flow_0wy65b3" sourceRef="P3_Task7" targetRef="P3_Task5" />
    <sequenceFlow id="P3_sf5" sourceRef="P3_Task5" targetRef="P3_Task6" />
    <sequenceFlow id="P3_sf_join" name="Nacheinsatz abgeschlossen" sourceRef="P3_Task6" targetRef="P3_GW3" />
    <sequenceFlow id="P3_sf6" sourceRef="P3_Task7" targetRef="P3_Task8" />
    <sequenceFlow id="P3_sf_join2" name="Lösung erarbeitet" sourceRef="P3_Task8" targetRef="P3_GW3" />
    <sequenceFlow id="P3_sf7" sourceRef="P3_GW3" targetRef="P3_Task9" />
    <sequenceFlow id="P3_sf8" sourceRef="P3_Task9" targetRef="P3_Task10" />
    <sequenceFlow id="P3_sf_end" sourceRef="P3_Task10" targetRef="P3_End2" />
    <sequenceFlow id="P3_sf1" sourceRef="P3_Start" targetRef="P3_Task1" />
    <sequenceFlow id="P3_sf2" sourceRef="P3_Task1" targetRef="P3_GW1" />
    <sequenceFlow id="P3_sf_rueckfrage" name="Rückfrage" sourceRef="P3_GW1" targetRef="P3_Task2">
      <conditionExpression xsi:type="tFormalExpression">${meldungsart == 'rueckfrage'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="P3_sf_rueck_end" sourceRef="P3_Task2" targetRef="P3_End1" />
    <sequenceFlow id="P3_sf_reklamation" name="Reklamation" sourceRef="P3_GW1" targetRef="P3_Task3">
      <conditionExpression xsi:type="tFormalExpression">${meldungsart == 'nachbefall' || meldungsart == 'qualitaet'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1rtph18" sourceRef="P3_Task3" targetRef="P3_GW2" />
    <sequenceFlow id="P3_sf_garantie" name="Ja (innerhalb 6 Monate)" sourceRef="P3_GW2" targetRef="P3_Task4">
      <conditionExpression xsi:type="tFormalExpression">${garantieAktiv == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="P3_sf_eskalation" name="Nein (außerhalb Garantie)" sourceRef="P3_GW2" targetRef="P3_Task7">
      <conditionExpression xsi:type="tFormalExpression">${garantieAktiv == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="P3_sf4" sourceRef="P3_Task4" targetRef="P3_Task7" />
  </process>
  <bpmndi:BPMNDiagram id="P3_Diagram">
    <bpmndi:BPMNPlane id="P3_Diagram_plane" bpmnElement="Collab_P3">
      <bpmndi:BPMNShape id="Shape_Part_PestPro_P3" bpmnElement="Part_PestPro_P3" isHorizontal="true">
